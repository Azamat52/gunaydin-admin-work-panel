# Nusxa oling va haqiqiy qiymatlarni hosting Environment Variables ichida kiriting.
# Bu faylga haqiqiy token yoki parol yozmang.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
PORT=4000
FRONTEND_URL=http://localhost:8080
BROADCAST_UPDATES=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
# Birinchi ishga tushishda admin yaratish uchun (production’da albatta belgilang).
ADMIN_LOGIN=change-this-login
ADMIN_PASSWORD=change-this-to-a-long-unique-password
